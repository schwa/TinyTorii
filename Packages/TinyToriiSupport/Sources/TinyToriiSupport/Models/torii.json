{
  // Palette names are TinyTorii Paint names; colors must match Paint's, which the loader maps back to.
  // A torii gate across x. POST, TOP and PLAQUE are paints; the "gate" component (also used by great-torii.json)
  // takes the size.
  "name": "Torii",
  "parameters": {
    "WIDTH": 0.75, "HEIGHT": 1.0, "THICKNESS": 0.06,
    "POST": "#D9452B", "TOP": "#262321", "PLAQUE": "#262321"
  },
  "palette": { "post": "$POST", "top": "$TOP", "plaque": "$PLAQUE", "blackWood": "#262321" },
  "components": {
    "gate": {
      "description": "Two leaning posts with black feet, the nuki (tie beam), the shimaki and the kasagi (top lintel, curving up at the ends), and the gakuzuka plaque between them. Uses palette names post, top, plaque and blackWood.",
      "parameters": {
        "W": 0.75, "H": 1.0, "T": 0.06,
        "HALF": "$W / 2",
        "TOPHALF": "$W * 0.82",
        "TOPY": "$H * 0.92"
      },
      "parts": [
        { "mirror": [
          { "loft": { "segments": 8, "sections": [
            { "z": 0, "radius": "$T * 0.75", "at": ["$HALF * 1.04", 0] },
            { "z": "$H * 0.9", "radius": "$T * 0.62", "at": ["$HALF", 0] }
          ] }, "color": "post", "rotate": [-90, 0, 0] },
          { "cylinder": { "bottom": "$T * 0.8", "top": "$T * 0.8", "height": "$H * 0.08", "segments": 8 },
            "color": "blackWood", "at": ["$HALF * 1.04", "$H * 0.04", 0] }
        ] },
        { "box": ["$W * 1.25", "$T * 0.8", "$T * 0.6"], "color": "post", "at": [0, "$H * 0.72", 0] },
        { "box": ["$W * 1.3", "$T * 0.75", "$T * 1.1"], "color": "post", "at": [0, "$TOPY", 0] },
        { "repeat": { "count": 6, "step": [0, 0, 0], "parts": [
          { "deform": {
            "parts": [
              { "box": ["$TOPHALF / 3", "$T * 0.8", "$T * 1.3"], "at": ["-$TOPHALF + ($I + 0.5) * $TOPHALF / 3", "$TOPY + $T * 0.8", 0] }
            ],
            "ops": [
              { "raise": { "amount": "$H * 0.08", "axis": "x", "from": 0, "to": "$TOPHALF", "power": 2.2 } },
              { "raise": { "amount": "$H * 0.08", "axis": "x", "from": 0, "to": "-$TOPHALF", "power": 2.2 } }
            ]
          } }
        ] }, "color": "top" },
        { "box": ["$T * 1.4", "$H * 0.14", "$T * 0.5"], "color": "plaque", "at": [0, "($H * 0.72 + $TOPY) / 2", 0] }
      ]
    }
  },
  "body": [
    { "use": "gate", "with": { "W": "$WIDTH", "H": "$HEIGHT", "T": "$THICKNESS" } }
  ]
}
