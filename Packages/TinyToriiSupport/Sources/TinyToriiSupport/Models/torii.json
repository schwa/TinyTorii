{
  // Palette names are TinyTorii Paint names; colors must match Paint's, which the loader maps back to.
  // A torii gate across x: two leaning posts with black feet, the nuki (tie beam), the shimaki and the kasagi
  // (top lintel, curving up at the ends), and the gakuzuka plaque between them.
  //   WIDTH, HEIGHT, THICKNESS  size of the gate. POST, TOP, PLAQUE  paints.
  "name": "Torii",
  "parameters": {
    "WIDTH": 0.75, "HEIGHT": 1.0, "THICKNESS": 0.06,
    "POST": "#D9452B", "TOP": "#262321", "PLAQUE": "#262321",
    "HALF": "$WIDTH / 2",
    "TOPHALF": "$WIDTH * 0.82",
    "TOPY": "$HEIGHT * 0.92"
  },
  "palette": { "post": "$POST", "top": "$TOP", "plaque": "$PLAQUE", "blackWood": "#262321" },
  "body": [
    { "mirror": [
      { "loft": { "segments": 8, "sections": [
        { "z": 0, "radius": "$THICKNESS * 0.75", "at": ["$HALF * 1.04", 0] },
        { "z": "$HEIGHT * 0.9", "radius": "$THICKNESS * 0.62", "at": ["$HALF", 0] }
      ] }, "color": "post", "rotate": [-90, 0, 0] },
      { "cylinder": { "bottom": "$THICKNESS * 0.8", "top": "$THICKNESS * 0.8", "height": "$HEIGHT * 0.08", "segments": 8 },
        "color": "blackWood", "at": ["$HALF * 1.04", "$HEIGHT * 0.04", 0] }
    ] },
    { "box": ["$WIDTH * 1.25", "$THICKNESS * 0.8", "$THICKNESS * 0.6"], "color": "post", "at": [0, "$HEIGHT * 0.72", 0] },
    { "box": ["$WIDTH * 1.3", "$THICKNESS * 0.75", "$THICKNESS * 1.1"], "color": "post", "at": [0, "$TOPY", 0] },
    { "repeat": { "count": 6, "step": [0, 0, 0], "parts": [
      { "deform": {
        "parts": [
          { "box": ["$TOPHALF / 3", "$THICKNESS * 0.8", "$THICKNESS * 1.3"], "at": ["-$TOPHALF + ($I + 0.5) * $TOPHALF / 3", "$TOPY + $THICKNESS * 0.8", 0] }
        ],
        "ops": [
          { "raise": { "amount": "$HEIGHT * 0.08", "axis": "x", "from": 0, "to": "$TOPHALF", "power": 2.2 } },
          { "raise": { "amount": "$HEIGHT * 0.08", "axis": "x", "from": 0, "to": "-$TOPHALF", "power": 2.2 } }
        ]
      } }
    ] }, "color": "top" },
    { "box": ["$THICKNESS * 1.4", "$HEIGHT * 0.14", "$THICKNESS * 0.5"], "color": "plaque", "at": [0, "($HEIGHT * 0.72 + $TOPY) / 2", 0] }
  ]
}
