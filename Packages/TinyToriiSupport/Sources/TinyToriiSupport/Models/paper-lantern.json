{
  // Palette names are TinyTorii Paint names; colors must match Paint's, which the loader maps back to.
  // Sizes in meters. Two poles 4.2 apart with a sagging rope of COUNT paper lanterns between them, HEIGHT tall. Lantern N's paint is
  // LANTERN0, LANTERN1 or LANTERN2 by N mod 3; ROW0-2 say how many lanterns each of those gets (expressions have no
  // modulo, so the caller counts them).
  "name": "Paper lanterns",
  "parameters": {
    "HEIGHT": 4.2, "COUNT": 2, "ROW0": 1, "ROW1": 1, "ROW2": 0,
    "LANTERN0": "#D03A2A", "LANTERN1": "#D03A2A", "LANTERN2": "#D03A2A",
    "HALF": 2.1,
    "ROPE": "$HEIGHT - 0.175"
  },
  "palette": {
    "lantern0": "$LANTERN0", "lantern1": "$LANTERN1", "lantern2": "$LANTERN2",
    "darkWood": "#4A3324", "twine": "#2A2420", "blackWood": "#262321"
  },
  "components": {
    "lantern": {
      "description": "Lantern number N hanging from the rope, in the color of the part that uses it.",
      "parameters": {
        "N": 0,
        "T": "($N + 0.5) / $COUNT",
        "X": "-$HALF + $T * $HALF * 2",
        "Y": "$ROPE - 0.525 * (1 - (2 * $T - 1) * (2 * $T - 1))"
      },
      "parts": [
        { "cylinder": { "bottom": 0.021, "top": 0.021, "height": 0.28, "segments": 3 }, "color": "twine", "at": ["$X", "$Y - 0.14", 0] },
        { "icosahedron": { "radius": 1 }, "scale": [0.315, 0.455, 0.315], "at": ["$X", "$Y - 0.7", 0] },
        { "cylinder": { "bottom": 0.175, "top": 0.175, "height": 0.07, "segments": 8 }, "color": "blackWood", "at": ["$X", "$Y - 1.12", 0] }
      ]
    }
  },
  "body": [
    { "mirror": [
      { "cylinder": { "bottom": 0.1225, "top": 0.1225, "height": "$HEIGHT", "segments": 8 }, "color": "darkWood", "at": ["$HALF", "$HEIGHT / 2", 0] }
    ] },
    { "repeat": { "count": "$ROW0", "step": [0, 0, 0], "parts": [{ "use": "lantern", "with": { "N": "3 * $I" } }] }, "color": "lantern0" },
    { "repeat": { "count": "$ROW1", "step": [0, 0, 0], "parts": [{ "use": "lantern", "with": { "N": "1 + 3 * $I" } }] }, "color": "lantern1" },
    { "repeat": { "count": "$ROW2", "step": [0, 0, 0], "parts": [{ "use": "lantern", "with": { "N": "2 + 3 * $I" } }] }, "color": "lantern2" },
    { "repeat": { "count": 16, "step": [0, 0, 0], "parts": [
      { "deform": {
        "parts": [
          { "box": ["$HALF / 8", 0.042, 0.042], "at": ["-$HALF + ($I + 0.5) * $HALF / 8", "$ROPE - 0.525", 0] }
        ],
        "ops": [
          { "raise": { "amount": 0.525, "axis": "x", "from": 0, "to": "$HALF", "power": 2 } },
          { "raise": { "amount": 0.525, "axis": "x", "from": 0, "to": "-$HALF", "power": 2 } }
        ]
      } }
    ] }, "color": "twine" }
  ]
}
