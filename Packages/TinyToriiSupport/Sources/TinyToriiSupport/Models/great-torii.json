{
  // Palette names are TinyTorii Paint names; colors must match Paint's, which the loader maps back to.
  // The great torii: torii.json's gate at full size with a shimenawa rope; BRACED 1 adds the Itsukushima braced
  // legs. POST, TOP and PLAQUE are paints.
  "name": "Great torii",
  "imports": { "torii": "torii.json" },
  "parameters": { "BRACED": 0, "POST": "#D9452B", "TOP": "#262321", "PLAQUE": "#262321" },
  "palette": { "post": "$POST", "top": "$TOP", "plaque": "$PLAQUE", "blackWood": "#262321", "rope": "#E6D6A8" },
  "body": [
    { "use": "torii.gate", "with": { "W": 1.7, "H": 2.4, "T": 0.13 } },
    { "group": [
      { "mirror": [
        { "mirror": { "axis": "z", "parts": [
          { "cylinder": { "bottom": 0.06, "top": 0.06, "height": 1.5, "segments": 8 }, "at": [0.85, 0.75, 0.3] }
        ] } },
        { "box": [0.06, 0.06, 0.6], "at": [0.85, 1.2, 0] }
      ] }
    ], "color": "post", "if": "$BRACED" },
    { "box": [1.3, 0.05, 0.05], "color": "rope", "at": [0, 1.95, 0] }
  ]
}
