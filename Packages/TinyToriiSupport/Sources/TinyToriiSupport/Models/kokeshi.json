{
  // Palette names are TinyTorii Paint names; colors must match Paint's, which the loader maps back to.
  // A sōsaku kokeshi villager: a turned body with no arms or legs, painted bands, a round head with a painted hair
  // cap. The face looks along +x.
  //   PROFILE  three [height, radius] points from the base to the neck; the body is turned straight between them.
  //   BANDS    three [height, radius] painted rings; a radius of 0 leaves the ring out. BAND0-2 are their paints.
  //   HEAD     head radius.
  "name": "Kokeshi",
  "parameters": {
    "PROFILE": [[0, 0.147], [0.3325, 0.147], [0.665, 0.147]],
    "BANDS": [[0.105, 0.154], [0.525, 0.154], [0, 0]],
    "HEAD": 0.175,
    "NECK": "$PROFILE[2].x",
    "Y": "$NECK + $HEAD * 0.9",
    "CUT": "$Y + $HEAD * 1.03 * 0.29552",
    "BODY": "#B5352B", "BAND0": "#D8A93A", "BAND1": "#262321", "BAND2": "#262321", "HAIR": "#262321"
  },
  "palette": {
    "body": "$BODY", "band0": "$BAND0", "band1": "$BAND1", "band2": "$BAND2", "hair": "$HAIR",
    "foxWhite": "#F4F1EA", "blackWood": "#262321"
  },
  "body": [
    { "cylinder": { "bottom": "$PROFILE[0].y", "top": "$PROFILE[1].y", "height": "$PROFILE[1].x - $PROFILE[0].x", "segments": 10 },
      "color": "body", "at": [0, "($PROFILE[0].x + $PROFILE[1].x) / 2", 0] },
    { "cylinder": { "bottom": "$PROFILE[1].y", "top": "$PROFILE[2].y", "height": "$PROFILE[2].x - $PROFILE[1].x", "segments": 10 },
      "color": "body", "at": [0, "($PROFILE[1].x + $PROFILE[2].x) / 2", 0] },
    { "cylinder": { "bottom": "$BANDS[0].y", "top": "$BANDS[0].y", "height": 0.056, "segments": 10 }, "color": "band0", "at": [0, "$BANDS[0].x", 0], "if": "$BANDS[0].y > 0" },
    { "cylinder": { "bottom": "$BANDS[1].y", "top": "$BANDS[1].y", "height": 0.056, "segments": 10 }, "color": "band1", "at": [0, "$BANDS[1].x", 0], "if": "$BANDS[1].y > 0" },
    { "cylinder": { "bottom": "$BANDS[2].y", "top": "$BANDS[2].y", "height": 0.056, "segments": 10 }, "color": "band2", "at": [0, "$BANDS[2].x", 0], "if": "$BANDS[2].y > 0" },
    { "sphere": { "radius": "$HEAD", "widthSegments": 12, "heightSegments": 10 }, "color": "foxWhite", "at": [0, "$Y", 0] },
    { "intersection": [
      { "sphere": { "radius": "$HEAD * 1.03", "widthSegments": 12, "heightSegments": 10 }, "at": [0, "$Y", 0] },
      { "box": ["$HEAD * 3", "$HEAD * 2.06", "$HEAD * 3"], "at": [0, "$CUT + $HEAD * 1.03", 0] }
    ], "color": "hair" },
    { "mirror": { "axis": "z", "parts": [
      { "box": [0.028, 0.014, 0.042], "color": "blackWood", "at": ["$HEAD * 0.95", "$Y + 0.014", "$HEAD * 0.32"] }
    ] } }
  ]
}
