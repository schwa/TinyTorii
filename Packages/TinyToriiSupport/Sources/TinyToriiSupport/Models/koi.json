{
  // Palette names are TinyTorii Paint names; colors must match Paint's, which the loader maps back to.
  // BODY is the body and tail paint, SPOTS the two markings on the back.
  "name": "Koi",
  "parameters": { "BODY": "#F7F4EE", "SPOTS": "#F07A2A" },
  "palette": { "body": "$BODY", "spots": "$SPOTS" },
  "body": [
    { "icosahedron": { "radius": 1 }, "color": "body", "scale": [0.1225, 0.063, 0.315], "at": [0, 0, 0] },
    { "icosahedron": { "radius": 1 }, "color": "spots", "scale": [0.0875, 0.0455, 0.14], "at": [0, 0.028, 0.105] },
    { "icosahedron": { "radius": 1 }, "color": "spots", "scale": [0.077, 0.042, 0.105], "at": [0, 0.028, -0.14] },
    { "cylinder": { "top": 0, "bottom": 0.105, "height": 0.21, "segments": 4, "axis": "z" }, "color": "body", "at": [0, 0, -0.385] }
  ]
}
