{
  // Palette names are TinyTorii Paint names; colors must match Paint's, which the loader maps back to.
  // BODY is the body and tail paint, SPOTS the two markings on the back.
  "name": "Koi",
  "parameters": { "BODY": "#F7F4EE", "SPOTS": "#F07A2A" },
  "palette": { "body": "$BODY", "spots": "$SPOTS" },
  "body": [
    { "icosahedron": { "radius": 1 }, "color": "body", "scale": [0.035, 0.018, 0.09], "at": [0, 0, 0] },
    { "icosahedron": { "radius": 1 }, "color": "spots", "scale": [0.025, 0.013, 0.04], "at": [0, 0.008, 0.03] },
    { "icosahedron": { "radius": 1 }, "color": "spots", "scale": [0.022, 0.012, 0.03], "at": [0, 0.008, -0.04] },
    { "cylinder": { "top": 0, "bottom": 0.03, "height": 0.06, "segments": 4, "axis": "z" }, "color": "body", "at": [0, 0, -0.11] }
  ]
}
