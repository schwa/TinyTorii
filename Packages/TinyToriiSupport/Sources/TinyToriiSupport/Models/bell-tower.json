{
  // Palette names are TinyTorii Paint names; colors must match Paint's, which the loader maps back to.
  // A shōrō bell tower: four posts on a stone base, a bronze bell with its striking beam, under a hip roof.
  // POSTS and ROOF are paints.
  "name": "Bell tower",
  "imports": { "roofs": "roofs.json" },
  "parameters": { "POSTS": "#D9452B", "ROOF": "#4B5057" },
  "palette": {
    "posts": "$POSTS", "roof": "$ROOF",
    "stone": "#9C978E", "darkWood": "#4A3324", "bronze": "#5C5A3C", "lightWood": "#B8915F"
  },
  "body": [
    { "box": [1.1, 0.2, 1.1], "color": "stone", "at": [0, 0.1, 0] },
    { "mirror": [
      { "mirror": { "axis": "z", "parts": [
        { "box": [0.08, 1.5, 0.08], "color": "posts", "at": [0.4, 0.95, 0.4] }
      ] } }
    ] },
    { "box": [0.95, 0.06, 0.95], "color": "darkWood", "at": [0, 1.65, 0] },
    { "use": "roofs.hip-roof", "with": { "SIZE": 1.4, "RISE": 0.55 }, "at": [0, 1.7, 0] },
    { "cylinder": { "bottom": 0.24, "top": 0.17, "height": 0.7, "segments": 10 }, "color": "bronze", "at": [0, 1.1, 0] },
    { "icosahedron": { "radius": 1 }, "color": "bronze", "scale": [0.17, 0.08, 0.17], "at": [0, 1.48, 0] },
    { "box": [0.76, 0.07, 0.07], "color": "lightWood", "at": [0, 1.1, 0.3] }
  ]
}
