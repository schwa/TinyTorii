{
  // Palette names are TinyTorii Paint names; colors must match Paint's, which the loader maps back to.
  // A shōrō bell tower: four posts on a stone base, a bronze bell with its striking beam, under a hip roof.
  // POSTS and ROOF are paints.
  "name": "Bell tower",
  "imports": { "roofs": "roofs.json" },
  "parameters": { "POSTS": "#D9452B", "ROOF": "#4B5057" },
  "palette": {
    "posts": "$POSTS", "roof": "$ROOF",
    "stone": "#9C978E", "darkWood": "#4A3324", "bronze": "#5C5A3C", "lightWood": "#B8915F"
  },
  "body": [
    { "box": [3.85, 0.7, 3.85], "color": "stone", "at": [0, 0.35, 0] },
    { "mirror": [
      { "mirror": { "axis": "z", "parts": [
        { "box": [0.28, 5.25, 0.28], "color": "posts", "at": [1.4, 3.325, 1.4] }
      ] } }
    ] },
    { "box": [3.325, 0.21, 3.325], "color": "darkWood", "at": [0, 5.775, 0] },
    { "use": "roofs.hip-roof", "with": { "SIZE": 4.9, "RISE": 1.925 }, "at": [0, 5.95, 0] },
    { "cylinder": { "bottom": 0.84, "top": 0.595, "height": 2.45, "segments": 10 }, "color": "bronze", "at": [0, 3.85, 0] },
    { "icosahedron": { "radius": 1 }, "color": "bronze", "scale": [0.595, 0.28, 0.595], "at": [0, 5.18, 0] },
    { "box": [2.66, 0.245, 0.245], "color": "lightWood", "at": [0, 3.85, 1.05] }
  ]
}
